# syntax=docker/dockerfile:1.7

FROM rust:1.85-bookworm AS builder
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY services/symflow-api/rust-toolchain.toml services/symflow-api/
COPY services/symflow-api/Cargo.toml services/symflow-api/Cargo.lock services/symflow-api/
COPY packages/symflow-core/Cargo.toml packages/symflow-core/Cargo.toml
COPY packages/symflow-store/Cargo.toml packages/symflow-store/Cargo.toml
COPY services/symflow-api/Makefile.toml services/symflow-api/
COPY services/symflow-cli/Cargo.toml services/symflow-cli/Cargo.toml

RUN cargo install --locked cargo-make

RUN mkdir -p packages/symflow-core/src packages/symflow-store/src services/symflow-api/src services/symflow-cli/src \
    && touch packages/symflow-core/src/lib.rs packages/symflow-store/src/lib.rs services/symflow-api/src/main.rs services/symflow-cli/src/main.rs \
    && cd services/symflow-api \
    && cargo fetch --locked

COPY packages/symflow-core packages/symflow-core
COPY packages/symflow-store packages/symflow-store
COPY services/symflow-api services/symflow-api
COPY services/symflow-cli services/symflow-cli

RUN cd services/symflow-api && cargo make api-build-release

FROM debian:bookworm-slim AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/services/symflow-api/target/release/symflow-api /usr/local/bin/symflow-api

EXPOSE 8787
ENV SYMFLOW_API_ADDR=0.0.0.0:8787

ENTRYPOINT ["/usr/local/bin/symflow-api"]
