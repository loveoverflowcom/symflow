DATABASE_URL=postgres://symflow:symflow@127.0.0.1:5432/symflow?sslmode=disable
SYMFLOW_API_ADDR=127.0.0.1:8787
SYMFLOW_WEB_ORIGIN=http://localhost:5173
SYMFLOW_SESSION_COOKIE=symflow_session
SYMFLOW_SESSION_TTL_SECS=1209600
SYMFLOW_COOKIE_SECURE=false
# Set to 1 only for local flow-only development without PostgreSQL.
SYMFLOW_AUTH_DISABLED=0

RUST_LOG=info
LLM_API_KEY=
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_MODEL=Qwen/Qwen3-1.7B:featherless-ai
LLM_MAX_TOKENS=100
LLM_TEMPERATURE=0.7

# Gemini OCR/VL proxy used by idCardOcr.
GEMINI_API_KEY=
GEMINI_VISION_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent
