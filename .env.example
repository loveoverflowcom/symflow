# Sao chép thành `.env` và điền giá trị thật. KHÔNG commit `.env`.

# --- CSDL ---
# PostgreSQL (mặc định) — sym-api BẮT BUỘC; sym-cli tuỳ chọn.
DATABASE_URL=postgres://symflow:symflow@127.0.0.1:5432/symflow
# MariaDB (thay thế):
# DATABASE_URL=mysql://symflow:symflow@127.0.0.1:3306/symflow
# Không có DATABASE_URL → sym-cli dùng MemoryStore (in-memory).

# Mức log (tuỳ chọn)
# RUST_LOG=info,sym_core=debug,sqlx=warn

# --- Sandbox ghi file cục bộ ---
SANDBOX_DIR=./data/storage_sandbox

# --- LLM (nút ai_agent) ---
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1

# --- API server (sym-api) ---
SYM_API_BIND=127.0.0.1:8787
# Origin của SvelteKit khi dev (CORS)
SYM_WEB_ORIGIN=http://localhost:5173
